{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": [
      "spiderbot/**",
      "requirements.txt",
      "railway.json",
      ".python-version"
    ]
  },
  "deploy": {
    "startCommand": "python -m spiderbot",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
