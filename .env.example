# Names only. Never a value - not here, not in code, not in a log.
# Values live in Railway (production) and the owner's own environment (local).

# -- Discord ------------------------------------------------------------------
DISCORD_TOKEN=
GUILD_ID=
LOG_LEVEL=

# -- AI -----------------------------------------------------------------------
ANTHROPIC_API_KEY=
AI_ENABLED=
AI_MODEL=
AI_EFFORT=
AI_MAX_RESPONSE_TOKENS=
AI_MEMORY_TURNS=
AI_INITIATIVE_CHANNELS=
AI_INITIATIVE_COOLDOWN_SECONDS=
AI_INITIATIVE_HOURLY_CAP=

# -- Report intake ------------------------------------------------------------
# Fine-grained PAT, scoped to menno420/spider-swing with Issues: Read and write
# and nothing else. Absent = every publish is refused by name and the report
# stays queued; nothing is lost and nothing pretends to have been filed.
GITHUB_TOKEN=
GITHUB_REPO=
# Two independent locks. Publication is off even with a token present, so the
# first report reaching a public tracker is a decision rather than a side
# effect of setting a variable.
INTAKE_PUBLISH_ENABLED=

# -- Moderation ---------------------------------------------------------------
# off | shadow | enforce. Anything unrecognised is treated as shadow, so a typo
# does nothing rather than acting.
MOD_MODE=
# Comma-separated channel NAMES. Empty means moderation runs nowhere, not
# everywhere (invariant 4).
MOD_WATCH_CHANNELS=
# The rollout lever: nothing | flag_for_review | delete_message | warn |
# timeout_short | timeout_long. The whole classifier and policy path runs at
# flag_for_review and nothing a member can see ever changes. Raise it one class
# at a time, and only with review data behind the raise.
MOD_CEILING=
MOD_MODEL=

# -- The game support feed ----------------------------------------------------
# Where spider-swing publishes the versioned facts this bot needs. Empty falls
# back to the built-in notes, and the bot says so.
SUPPORT_FEED_URL=
SUPPORT_FEED_REFRESH_SECONDS=
